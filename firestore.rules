rules_version = '2';

// The only thing standing between one student's exam history and another's.
//
// This lived exclusively in the Firebase console until 2026-08-13, which meant
// the confidentiality of every backup depended on configuration that could not
// be read in this repository, could not be reviewed in a pull request, could not
// be restored from git, and could be destroyed by one wrong click. Worse, the
// two states are indistinguishable from the outside: a project left in Firestore
// **test mode** grants open read/write to any authenticated caller until the
// timestamp expires, and then denies everything — which would break backup for
// every student with no code change to explain it.
//
// The client half of this contract is `FirestoreBackupRepository`, which writes
// one document per student at `users/{uid}/backup/snapshot` -- and that one
// document, in that one shape, is all these rules admit.
//
// Deploy with:  firebase deploy --only firestore:rules
// Nothing deploys these automatically; `firebase.json` only makes it possible.
service cloud.firestore {
  match /databases/{database}/documents {

    // A student's backup is readable and writable by that student and nobody
    // else. `request.auth.uid == uid` is the whole guarantee: the uid in the
    // path has to be the uid on the token, so a client cannot ask for someone
    // else's document by editing a path.
    //
    // **One exact document, not `backup/{document=**}`** (S1). The client only
    // ever writes `users/{uid}/backup/snapshot`; the old wildcard also let a
    // signed-in client create any number of other documents, at any depth,
    // under its own `backup/` -- unbounded storage on this project's bill, and
    // none of it ever read by the app. Anything else under `backup/` now falls
    // through to the global deny below.
    match /users/{uid}/backup/snapshot {
      allow read: if request.auth != null && request.auth.uid == uid;

      // The document's shape is pinned to exactly what
      // `FirestoreBackupRepository.upload` writes, field by field:
      //
      //   payload        bytes      the gzipped record (size ceiling below)
      //   checksum       string     SHA-256 hex of the payload; absent on
      //                             documents written before format 3, and
      //                             builds from then are still installed, so it
      //                             is allowed rather than required
      //   formatVersion  int
      //   chapterCount   int >= 0   read by readMetadata without the payload
      //   examCount      int >= 0
      //   updatedAt      timestamp  FieldValue.serverTimestamp()
      //
      // `hasOnly` refuses any other field; `hasAll` requires the five every
      // build has always written. Change `upload()` and this list together --
      // `test/security/firestore_rules_test.dart` fails if they drift apart.
      //
      // The size ceiling is also enforced client-side (`_maxBlobBytes`, 900 KiB)
      // so a student gets a real error instead of a rejection they cannot read.
      // It is repeated here because a client-side limit is a courtesy, not a
      // control — the server must not depend on the app being the one asking.
      //
      // **It has to be `data.payload.size()`, not `resource.size()`.** The
      // latter was here first and enforced nothing at all: on a document,
      // `size()` counts *fields*, and this document has four of them, so
      // `4 < 1048576` was true for every write ever made. Measured against the
      // Firestore emulator on 2026-08-15: a single 1,000,000-byte `payload` —
      // well past the 900 KiB the client refuses — was accepted. On a `bytes`
      // value `size()` is the byte length, which is the number this was always
      // meant to be reading.
      //
      // Delete is split out for a second reason the old line hid: on a delete
      // there is no `request.resource` at all, so any condition touching it
      // evaluates to an error and denies. `allow write` covers delete, so the
      // backup document could never be removed — which is not a theoretical
      // loss, it is the operation an "erase my data" feature is made of.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly([
                                 'payload', 'checksum', 'formatVersion',
                                 'chapterCount', 'examCount', 'updatedAt'])
                            && request.resource.data.keys().hasAll([
                                 'payload', 'formatVersion',
                                 'chapterCount', 'examCount', 'updatedAt'])
                            && request.resource.data.payload is bytes
                            && request.resource.data.payload.size() <= 921600
                            && (!('checksum' in request.resource.data)
                                || request.resource.data.checksum is string)
                            && request.resource.data.formatVersion is int
                            && request.resource.data.chapterCount is int
                            && request.resource.data.chapterCount >= 0
                            && request.resource.data.examCount is int
                            && request.resource.data.examCount >= 0
                            && request.resource.data.updatedAt is timestamp;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Nothing else in this project is reachable from a client. Written
    // explicitly rather than left to the absence of a rule, so that adding a
    // collection later is a deliberate act with a rule attached, not something
    // that inherits access by being forgotten.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
