      "palettes": {
        "light":     { "plate": "#EFEFF2", "ring": "#000000", "accent": "#1B6EF3" },
        "dark":      { "plate": "#000000", "ring": "#FFFFFF", "accent": "#4D9BFF" },
        "glyph":     { "plate": null,      "ring": "#000000", "accent": "#1B6EF3" },
        "glyphDark": { "plate": null,      "ring": "#FFFFFF", "accent": "#4D9BFF" }
