      "glassBorder": "#FFFFFF1A",
      "switchOff": "#3A3A3E",
      "switchKnob": "#F2F2F5",
      "checkboxBorder": "#48484C",
      "dashedBorder": "#48484C",
      "scrim": "#0000008C"
    },
    "roles": {
      "pageBackground": "Every screen background.",
      "card": "Every card, list row, bottom sheet and dialog.",
      "muted": "Text-field fills and quieter/advisory cards.",
      "fill": "Icon circles, unselected chips, small tracks.",
      "track": "Progress-bar track.",
      "textPrimary": "Body and headings.",
      "textSecondary": "Secondary lines (passes WCAG AA on card).",
      "textTertiary": "Inactive tab labels, input hints.",
      "textMicro": "Fine print.",
      "textNoData": "The '—' for no data yet; week-circle borders.",
      "weekLabel": "Weekday letters.",
      "actionPrimary / onPrimary": "The toast plate (black in light, white in dark) and its text.",
      "accent / onAccent": "Brand blue and what sits on it. Material primary = accent.",
      "accentSoft": "Accent wash (12% light / 18% dark) for tints and chip backgrounds.",
      "actionDisabled": "Fill of a not-yet-available button (stays tappable, explains why).",
      "wrong / wrongTint / wrongText": "Red fill, red wash (error banner, overdue chip), red small text.",
      "right / rightText": "Green fill (ticks, switch on), green text.",
      "onState": "White text/icons on wrong or right fills, in both themes.",
      "divider": "Hairline between rows inside a card.",
      "glassBorder": "Edge of the translucent floating tab bar only.",
      "scrim": "Behind a bottom sheet."
    },
    "masteryRule": {
      "description": "Colour of a mastery/score number, evaluated in this order.",
      "order": [
        "no data → textNoData, render '—'",
        "overdue (needs review) → wrong (always with an icon too)",
        "< 50% → wrong",
        ">= 90% → rightText",
        "otherwise → textPrimary"
      ],
      "barFill": "Same rule for bars, except the neutral (textPrimary) branch becomes accent.",
      "barMinimumFraction": 0.02
    }
  },

  "typography": {
    "fontFamily": "Readex Pro",
    "fontSource": "Variable font, weight axis 200–700. Google Fonts: https://fonts.google.com/specimen/Readex+Pro (bundled beside this file: ReadexPro.ttf). Covers Arabic + Latin.",
    "variableFontNote": "Drive the 'wght' axis explicitly (Flutter: fontVariations: [FontVariation('wght', w)]), otherwise every weight renders the same.",
    "fontFeatures": ["tnum"],
    "weights": { "regular": 400, "medium": 500, "semiBold": 600, "bold": 700 },
    "units": "size and letterSpacing in logical px (dp); lineHeight is a multiplier of size.",
    "styles": {
      "resultNumber":      { "size": 56,   "weight": 700, "lineHeight": 1.0,  "letterSpacing": -2,   "use": "Dominant result number" },
      "celebrationNumber": { "size": 44,   "weight": 700, "lineHeight": 1.1,  "letterSpacing": -1.5, "use": "Celebration percentage" },
      "lockWordmark":      { "size": 38,   "weight": 700, "lineHeight": 1.1,  "letterSpacing": -0.6, "use": "Wordmark on splash/lock" },
      "lessonNumber":      { "size": 34,   "weight": 700, "lineHeight": 1.1,  "letterSpacing": -0.5, "use": "Lesson mastery number" },
      "today":             { "size": 32,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": -0.5, "use": "Home screen title (display)" },
      "cardNumber":        { "size": 30,   "weight": 700, "lineHeight": 1.1,  "letterSpacing": -0.5, "use": "Summary-card number" },
      "inputLarge":        { "size": 28,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Big numeric input" },
      "stepTitle":         { "size": 26,   "weight": 700, "lineHeight": 1.25, "letterSpacing": -0.4, "use": "Wizard step heading" },
      "sectionTitle":      { "size": 22,   "weight": 700, "lineHeight": 1.3,  "letterSpacing": -0.3, "use": "Section heading" },
      "screenTitle":       { "size": 20,   "weight": 700, "lineHeight": 1.3,  "letterSpacing": -0.3, "use": "Inner-screen / app-bar title" },
      "rowNumber":         { "size": 19,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Row trailing number; stat value" },
      "rowNumberSmall":    { "size": 18,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Smaller row trailing number" },
      "emptyTitle":        { "size": 18,   "weight": 700, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Empty-state heading" },
      "rowTitle":          { "size": 17,   "weight": 700, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "List row title" },
      "input":             { "size": 17,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Numeric input text" },
      "rowTitleSmall":     { "size": 16.5, "weight": 700, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Denser row title" },
      "cardTitle":         { "size": 16,   "weight": 700, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Card heading" },
      "cardLabel":         { "size": 16,   "weight": 600, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Label inside a card" },
      "button":            { "size": 16,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "color": "onAccent (filled) / textPrimary (text button)", "use": "Button label" },
      "rowNumberCompact":  { "size": 16,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Number on a row inside a card" },
      "body":              { "size": 15,   "weight": 500, "lineHeight": 1.5,  "letterSpacing": 0,    "use": "Body text" },
      "listTitle":         { "size": 15,   "weight": 600, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Row title inside a card" },
      "itemLabel":         { "size": 15,   "weight": 500, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Checklist / task label" },
      "controlLabel":      { "size": 14,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Segment, tally, quiet action" },
      "pillLabel":         { "size": 14,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "color": "onAccent", "use": "Label on an accent pill" },
      "rowStatus":         { "size": 14,   "weight": 500, "lineHeight": 1.4,  "letterSpacing": 0,    "use": "Status line under a row title (wrong or textSecondary)" },
      "statLabel":         { "size": 14,   "weight": 600, "lineHeight": 1.3,  "letterSpacing": 0,    "use": "Stat label" },
      "secondary":         { "size": 14,   "weight": 500, "lineHeight": 1.5,  "letterSpacing": 0,    "color": "textSecondary", "use": "Secondary text" },
      "secondaryStrong":   { "size": 14,   "weight": 600, "lineHeight": 1.5,  "letterSpacing": 0,    "color": "textSecondary", "use": "Emphasised secondary text" },
      "toastMessage":      { "size": 14,   "weight": 600, "lineHeight": 1.35, "letterSpacing": 0,    "color": "onPrimary", "use": "Toast text" },
      "statusLine":        { "size": 13,   "weight": 600, "lineHeight": 1.4,  "letterSpacing": 0,    "use": "Short verdict line" },
      "chipLabel":         { "size": 13,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Chip label" },
      "sublabel":          { "size": 13,   "weight": 500, "lineHeight": 1.5,  "letterSpacing": 0,    "color": "textSecondary", "use": "Explanation under a card heading" },
      "groupHeading":      { "size": 13,   "weight": 600, "lineHeight": 1.3,  "letterSpacing": 0,    "color": "textSecondary", "use": "Settings group heading" },
      "statDenominator":   { "size": 13,   "weight": 600, "lineHeight": 1.2,  "letterSpacing": 0,    "color": "textSecondary", "use": "'/ 24' under a count" },
      "dayLabel":          { "size": 13,   "weight": 600, "lineHeight": 1.2,  "letterSpacing": 0,    "color": "weekLabel", "use": "Weekday letters" },
      "chartValue":        { "size": 12,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Value above a chart column" },
      "small":             { "size": 12,   "weight": 500, "lineHeight": 1.4,  "letterSpacing": 0,    "color": "textSecondary", "use": "Breadcrumbs, chart labels" },
      "smallStrong":       { "size": 12,   "weight": 700, "lineHeight": 1.35, "letterSpacing": 0,    "color": "textSecondary", "use": "Strong small text" },
      "fieldLabel":        { "size": 12,   "weight": 600, "lineHeight": 1.3,  "letterSpacing": 0,    "color": "textSecondary", "use": "Label above an input" },
      "tabLabel":          { "size": 11,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Tab-bar label" },
      "badgeLabel":        { "size": 11,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Mini badge" },
      "chartLabel":        { "size": 11,   "weight": 600, "lineHeight": 1.2,  "letterSpacing": 0,    "color": "textSecondary", "use": "Name under a chart column" },
      "micro":             { "size": 11,   "weight": 400, "lineHeight": 1.5,  "letterSpacing": 0,    "color": "textMicro", "use": "Fine print" },
      "badgeCount":        { "size": 10,   "weight": 700, "lineHeight": 1.2,  "letterSpacing": 0,    "use": "Count inside a 16px badge disc (only size below 11)" }
    },
    "materialTextTheme": {
      "displayLarge": "today",
      "displayMedium": "sectionTitle",
      "titleLarge": "screenTitle",
      "titleMedium": "cardTitle",
      "titleSmall": "rowTitle",
      "bodyLarge": "body",
      "bodyMedium": "body",
      "bodySmall": "secondary",
      "labelLarge": "button",
      "labelMedium": "chipLabel",
      "labelSmall": "micro"
    }
  },

  "spacing": {
    "xxs": 4,
    "xs": 8,
    "md": 12,
    "xl": 16,
    "xxl": 20,
    "xxxl": 24,
    "opticalInset": 2,
    "textGap": 6,
    "pageMargin": 16,
    "cardPadding": 16,
    "listGap": 12,
    "inputPadding": { "horizontal": 16, "vertical": 12 }
  },

  "radius": {
    "card": 16,
    "button": 14,
    "input": 12,
    "segment": 8,
    "sheet": 22,
    "dialog": 16,
    "pill": 999
  },

  "sizes": {
    "primaryButton": 52,
    "headerButton": 36,
    "input": 46,
    "inputTall": 50,
    "bigNumberField": 72,
    "checkbox": 24,
    "minTouchTarget": 48,
    "dayPicker": 48,
    "barTrack": 8,
    "barTrackSmall": 6,
    "sheetHandle": { "width": 36, "height": 5 },
    "tabBar": { "height": 64, "lift": 12, "iconSize": 25, "badgeDisc": 16 },
    "toastBottom": 104
  },

  "borders": {
    "divider": { "width": 1, "color": "divider" },
    "inputDefault": "none (filled with muted)",
    "inputFocused": { "width": 1.5, "color": "accent" },
    "inputError": { "width": 1, "color": "wrong" },
    "inputErrorFocused": { "width": 1.5, "color": "wrong" }
  },

  "elevation": {
    "shadows": "none",
    "surfaceTint": "none",
    "glass": {
      "use": "The floating tab bar ONLY — the one blur in the app.",
      "blurSigma": 24,
      "tintOpacity": 0.85,
      "tintColor": "card",
      "border": "glassBorder"
    }
  },

  "components": {
    "primaryButton": { "background": "accent", "foreground": "onAccent", "height": 52, "radius": 14, "textStyle": "button", "elevation": 0, "fullWidth": true },
    "textButton": { "foreground": "textPrimary", "textStyle": "button" },
    "card": { "background": "card", "radius": 16, "padding": 16, "elevation": 0, "gapBetween": 12 },
    "input": { "background": "muted", "radius": 12, "height": 46, "hintColor": "textTertiary", "labelOutside": "fieldLabel" },
    "bottomSheet": { "background": "card", "topRadius": 22, "scrim": "scrim", "handle": "36×5, pill radius" },
    "dialog": { "background": "card", "radius": 16, "elevation": 0 },
    "chip": { "radius": 999, "restingBackground": "fill", "selectedBackground": "accent", "selectedForeground": "onAccent", "textStyle": "chipLabel" },
    "segmentedControl": { "boxRadius": 12, "padding": 4, "segmentRadius": 8 },
    "progressBar": { "height": 8, "smallHeight": 6, "track": "track", "fill": "masteryRule.barFill", "radius": 999 },
    "switch": { "on": "right", "off": "switchOff", "knob": "switchKnob" },
    "checkbox": { "size": 24, "border": "checkboxBorder", "checked": "accent", "checkColor": "onAccent" },
    "toast": { "background": "actionPrimary", "text": "toastMessage", "durationMs": 2200 },
    "errorBanner": { "background": "wrongTint", "text": "wrongText" },
    "appBar": { "background": "pageBackground", "elevation": 0, "centerTitle": false, "title": "screenTitle" },
    "tabBar": { "style": "Floating glass pill", "active": "accent", "inactive": "textTertiary", "label": "tabLabel" },
    "pressFeedback": { "scale": 0.97, "durationMs": 140, "ripple": false }
  },

  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.23, 1, 0.32, 1)",
      "press": "cubic-bezier(0.34, 1.4, 0.64, 1)",
      "sheet": "cubic-bezier(0.22, 1, 0.36, 1)",
      "celebration": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "value": "cubic-bezier(0.215, 0.61, 0.355, 1)"
    },
    "durationMs": {
      "nav": 150,
      "microOut": 150,
      "press": 140,
      "flood": 120,
      "micro": 180,
      "exit": 200,
      "step": 200,
      "pop": 200,
      "page": 220,
      "tick": 220,
      "segment": 250,
      "enter": 260,
      "sheet": 280,
      "celebration": 500,
      "value": 600,
      "toast": 2200
    },
    "distancePx": {
      "pageRise": 8,
      "enterRise": 12,
      "stepRise": 10,
      "microRise": 6,
      "toastRise": 12
    },
    "stagger": { "delayMs": 40, "maxItems": 6 },
    "springs": {
      "crisp":     { "mass": 1, "stiffness": 625, "dampingRatio": 1.0,  "use": "Presses, quiet returns (no bounce, ~160ms)" },
      "select":    { "mass": 1, "stiffness": 361, "dampingRatio": 0.70, "use": "Tab picks, releases (~300ms, ~4.6% overshoot)" },
      "settle":    { "mass": 1, "stiffness": 220, "dampingRatio": 0.81, "use": "Sheets, panels, indicators (default)" },
      "celebrate": { "mass": 1, "stiffness": 390, "dampingRatio": 0.45, "use": "Rare signature moments only (~450ms, ~20% overshoot)" }
    },
    "rules": [
      "Interface motion stays under 300ms and uses ease-out; never ease-in.",
      "Page transitions fade + rise vertically (RTL-safe), never slide horizontally.",
      "Exits are shorter than entrances.",
      "Badges and ticks never overshoot past 1.0.",
      "Respect reduce-motion: jump to the end state."
    ]
  },

  "layout": {
    "designTarget": "Phone, single column",
    "breakpoints": { "compact": "< 600", "roomy": ">= 600 (same single column, width capped)" },
    "direction": "rtl (Arabic first), English supported",
    "digits": "Western (0-9) in both languages",
    "scrollbars": "hidden"
  },

  "brand": {
    "wordmark": "Ather",
    "mark": {
