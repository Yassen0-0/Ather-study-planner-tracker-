      "textNoData": "#5A5A60",
      "weekLabel": "#8E8E94",
      "actionPrimary": "#FFFFFF",
      "onPrimary": "#000000",
      "accent": "#4D9BFF",
      "onAccent": "#04203F",
      "accentSoft": "#4D9BFF2E",
      "actionDisabled": "#2C2C2E",
      "wrong": "#FF3B30",
      "wrongTint": "#FF3B3026",
      "wrongText": "#FF3B30",
      "right": "#34C759",
      "rightText": "#34C759",
      "onState": "#FFFFFF",
